  <step>
    <name>Crear-nuevas-variables</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
// VARIABLE TIPO-DOCUMENTO
var tipo_documento = "SIN_DATO";

if (documento != null &amp;&amp; documento.length > 0) {
   var primerChar = documento.charAt(0);

   if (primerChar >= "1" &amp;&amp; primerChar &lt;= "9") {
      tipo_documento = "CEDULA DE IDENTIDAD";
   } else if (primerChar == "E") {
      tipo_documento = "EXTRANJERO";
   } else if (primerChar == "V") {
      tipo_documento = "PUESTO_VACANTE";
   } else if (primerChar == "A") {
      tipo_documento = "ANONIMATO";
   }
}

tipo_documento;


// VARIABLE FUENTE-FINANCIAMIENTO-DESCRIPCION
var fuente_financiamiento_descripcion = "SIN_DATO";
var codigo_string = fuente_financiamiento_codigo.toString(); 

switch (codigo_string) {
   case '10':
      fuente_financiamiento_descripcion = "TESORO_PUBLICO";
      break;
   case '20':
      fuente_financiamiento_descripcion = "PRESTAMOS";
      break;
   case '30':
      fuente_financiamiento_descripcion = "RECURSOS_INTITUCIONALES";
      break;
   default:
      fuente_financiamiento_descripcion = "SIN_DATO";
}

// VARIABLE FECHA DE NACIOMIENTO
// Fecha bandera
var fecha_bandera = new Date("1900-01-01");

// Validación de fecha_nacimiento
var fecha_valida;
if (fecha_nacimiento == null || fecha_nacimiento == "") {
   fecha_valida = fecha_bandera;
} else {
   try {
      var f = new Date(fecha_nacimiento);
      if (isNaN(f.getTime())) {
         fecha_valida = fecha_bandera;
      } else {
         fecha_valida = f;
      }
   } catch (e) {
      fecha_valida = fecha_bandera;
   }
}

// Calcular edad
var hoy = new Date();
var edad = hoy.getFullYear() - fecha_valida.getFullYear();
var m = hoy.getMonth() - fecha_valida.getMonth();
if (m &lt; 0 || (m === 0 &amp;&amp; hoy.getDate() &lt; fecha_valida.getDate())) {
   edad--;
}

// Grupo etario
var grupo_etario = "SIN_DATO";
if (edad >= 0 &amp;&amp; edad &lt;= 17) {
   grupo_etario = "MENOR DE EDAD";
} else if (edad >= 18 &amp;&amp; edad &lt;= 29) {
   grupo_etario = "JOVEN";
} else if (edad >= 30 &amp;&amp; edad &lt;= 44) {
   grupo_etario = "ADULTO";
} else if (edad >= 45 &amp;&amp; edad &lt;= 64) {
   grupo_etario = "ADULTO MAYOR";
} else if (edad >= 65) {
   grupo_etario = "TERCERA EDAD";
}


// Clasificación por generación
var generacion = "SIN_DATO";
var anio = fecha_valida.getFullYear();

if (anio >= 1997 &amp;&amp; anio &lt;= 2012) {
   generacion = "Generación Z";
} else if (anio >= 1981 &amp;&amp; anio &lt;= 1996) {
   generacion = "Generación Y (Millennials)";
} else if (anio >= 1965 &amp;&amp; anio &lt;= 1980) {
   generacion = "Generación X";
} else if (anio >= 1946 &amp;&amp; anio &lt;= 1964) {
   generacion = "Baby Boomers";
} else if (anio &lt; 1946) {
   generacion = "Generación Silenciosa";
} else if (anio >= 2013) {
   generacion = "Generación Alfa";
}


// Variables de salida
fecha_valida;
edad;
grupo_etario;
generacion;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
